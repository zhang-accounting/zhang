    "react-router-dom": "^6.23.1",
    "react-use": "^17.6.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^3.5.2",
    "yet-another-react-lightbox": "^3.18.0"
