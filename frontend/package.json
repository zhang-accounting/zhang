{
  "name": "frontend2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test 'src/**/*.test.ts'",
    "prettier:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "i18n-server": "node src/server.js",
    "api": "openapi-typescript http://localhost:8000/openapi.json --output ./src/api/schemas.ts && prettier --write ./src/api/schemas.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@uiw/react-codemirror": "^4.22.0",
    "bignumber.js": "^9.1.2",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "i18next": "^23.11.4",
    "i18next-http-backend": "^2.5.1",
    "jotai": "^2.9.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "openapi-typescript-fetch": "^2.1.0",
    "react": "^19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^15.0.2",
