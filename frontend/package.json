    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "express": "^4.21.0",
    "globals": "^15.9.0",
    "husky": "^9.0.11",
    "i18next-parser": "^8.13.0",
    "lint-staged": "^15.2.2",
    "openapi-typescript": "^6.7.5",
