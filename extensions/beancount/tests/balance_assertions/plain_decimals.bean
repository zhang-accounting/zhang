; Numbers as zhang writes them, in plain notation, never with an exponent beancount
; cannot read: very small, very large and of a high scale. Beancount reads each, and
; pads and checks with them as zhang does.
option "operating_currency" "CNY"

1970-01-01 commodity CNY
1970-01-01 open Assets:Small
1970-01-01 open Assets:Large
1970-01-01 open Assets:Scale
1970-01-01 open Equity:Small
1970-01-01 open Equity:Large
1970-01-01 open Equity:Scale

2024-01-02 * "small"
  Assets:Small 0.000000001 CNY
  Equity:Small -0.000000001 CNY
2024-01-02 * "large"
  Assets:Large 1200000000000000000000000000000 CNY
  Equity:Large -1200000000000000000000000000000 CNY
2024-01-02 * "scale"
  Assets:Scale 0.1234567890123456789012345678 CNY
  Equity:Scale -0.1234567890123456789012345678 CNY

2024-01-03 balance Assets:Small 0.000000001 CNY
2024-01-03 balance Assets:Large 1200000000000000000000000000000 CNY
2024-01-03 balance Assets:Scale 0.1234567890123456789012345678 CNY

2024-01-04 pad Assets:Small Equity:Small
2024-01-05 balance Assets:Small 0.000000003 CNY
