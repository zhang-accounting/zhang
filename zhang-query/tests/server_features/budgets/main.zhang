; The budget ledger of zhang-query/tests/server_features.rs: #budgets activity converted to the
; budget's commodity at each posting's date, per-month `closed`, and #budget_events. The only
; prices are CNY quoted in USD, so a USD posting converts to CNY through the inverse rate:
; 1 / 0.125 = 8 CNY per USD from 2024-01-01, 1 / 0.1 = 10 CNY per USD from 2024-03-01.
; The ledger's timezone is UTC+8, so the first half hour of a day is the previous day in UTC.
option "operating_currency" "CNY"
option "timezone" "Asia/Shanghai"

1970-01-01 commodity CNY
1970-01-01 commodity USD

1970-01-01 open Assets:Bank
1970-01-01 open Assets:Card
1970-01-01 open Expenses:Food
  budget: food
1970-01-01 open Expenses:Travel
  budget: travel

2024-01-01 price CNY 0.125 USD
2024-03-01 price CNY 0.1 USD

2024-01-01 budget food CNY
2024-01-01 budget travel CNY
2024-01-01 budget-add food 1000 CNY
2024-01-01 09:30:00 budget-add travel 500 CNY

2024-01-10 * "Market" "Groceries"
  Expenses:Food                 100 CNY
  Assets:Bank                  -100 CNY

2024-01-20 * "Airport" "Cafe abroad"
  Expenses:Food                  10 USD
  Assets:Card                   -10 USD

; 00:30 in UTC+8 is still 2024-01-31 in UTC: the ledger date decides the month
2024-02-01 00:30:00 budget-add travel 50 CNY

2024-02-15 budget-transfer food travel 200 CNY

; a budget that does not exist: an error, and no effect on any budget
2024-02-20 budget-add vacation 10 CNY

; the last day of a leap February, then the first moments of March (still February in UTC),
; when the March price applies
2024-02-29 * "Market" "Leap day groceries"
  Expenses:Food                  29 CNY
  Assets:Bank                   -29 CNY

2024-03-01 00:30:00 * "Abroad" "Breakfast on the first"
  Expenses:Food                   1 USD
  Assets:Card                    -1 USD

2024-03-05 * "Abroad" "Dinner"
  Expenses:Food                  10 USD
  Assets:Card                   -10 USD

2024-03-20 budget-close travel

2024-04-02 * "Market" "Groceries"
  Expenses:Food                  50 CNY
  Assets:Bank                   -50 CNY
