option "operating_currency" "USD"
option "timezone" "Asia/Kolkata"
1970-01-01 commodity USD
1970-01-01 commodity HOOL
1970-01-01 open Assets:Broker
1970-01-01 open Assets:Cash
1970-01-01 open Assets:Bank
1970-01-01 open Equity:Opening
1970-01-01 open Income:Trading
1970-01-01 open Expenses:Misc

2024-01-01 * "Buy" "three at total"
  Assets:Broker 3 HOOL {{1000 USD}}
  Assets:Cash -1000 USD

2024-01-02 * "Buy" "two at 400"
  Assets:Broker 2 HOOL {400 USD}
  Assets:Cash -800 USD

2024-01-03 * "Sell" "one from first lot, empty total cost"
  Assets:Broker -1 HOOL {{}} @ 500 USD
  Assets:Cash 500 USD
  Income:Trading

2024-01-04 * "Sell" "all remaining across lots"
  Assets:Broker -4 HOOL {} @@ 2000 USD
  Assets:Cash 2000 USD
  Income:Trading

2024-01-05 * "Timed" "via time meta"
  time: "23:59:59"
  Assets:Cash -1 USD
  Expenses:Misc

2024-01-05 * "Zero" "a zero posting"
  Assets:Cash 0 USD
  Expenses:Misc 0 USD

2024-01-06 * "Meta" "repeated meta keys" #b-tag #a-tag ^z-link ^a-link
  k: "1"
  k: "2"
  a: TRUE
  n: 12.5
  d: 2024-01-01
  Assets:Cash -1 USD
    pk: "x"
  Expenses:Misc

2024-01-07 pad Assets:Bank Equity:Opening
2024-01-08 balance Assets:Bank 100 USD
2024-01-08 balance Assets:Cash -303 USD
2024-01-09 balance Assets:Cash -300 ~ 5 USD
