[
  {
    "method": "POST",
    "uri": "/api/query/builtins/journals.errors",
    "body": {
      "params": {
        "size": 100,
        "offset": 0
      },
      "count_total": true
    },
    "validations": [
      [
        "$.data.length()",
        2
      ],
      [
        "$.data[0].kind",
        "MultipleOperatingCurrencyDetect"
      ],
      [
        "$.data[1].kind",
        "MultipleOperatingCurrencyDetect"
      ]
    ]
  },
  {
    "uri": "/api/options",
    "validations": [
      [
        "$.data[?(@.key=='operating_currency')].value",
        "EUR"
      ]
    ]
  },
  {
    "uri": "/api/commodities",
    "validations": [
      [
        "$.data[?(@.name=='CNY')].name",
        "CNY"
      ],
      [
        "$.data[?(@.name=='USD')].name",
        "USD"
      ],
      [
        "$.data[?(@.name=='EUR')].name",
        "EUR"
      ]
    ]
  }
]
