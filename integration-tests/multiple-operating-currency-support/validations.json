[
  {
    "uri": "/api/errors",
    "validations": [
      [
        "$.data.records.length()",
        2
      ],
      [
        "$.data.records[0].error_type",
        "MultipleOperatingCurrencyDetect"
      ],
      [
        "$.data.records[1].error_type",
        "MultipleOperatingCurrencyDetect"
      ]
    ]
  },
  {
    "uri": "/api/options",
    "validations": [
      [
        "$.data[?(@.key=='operating_currency')].value",
        "EUR"
      ]
    ]
  },
  {
    "uri": "/api/commodities",
    "validations": [
      [
        "$.data[?(@.name=='CNY')].name",
        "CNY"
      ],
      [
        "$.data[?(@.name=='USD')].name",
        "USD"
      ],
      [
        "$.data[?(@.name=='EUR')].name",
        "EUR"
      ]
    ]
  }
]
