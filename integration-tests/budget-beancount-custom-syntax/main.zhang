option "operating_currency" "CNY"

2023-12-01 open Assets:BankCard CNY
2023-12-01 open Expenses:Food CNY
  budget: "food"
2023-12-01 open Expenses:Fun CNY
  budget: "fun"

; the same budgets as main.bean, in zhang's own directives (#500)
2023-12-01 budget food CNY
  alias: "外食"
  category: "生活开销｜55%"
2023-12-01 budget fun CNY
  alias: "娱乐"
2023-12-01 budget vacation CNY

2023-12-01 budget-add food 1000 CNY
2023-12-01 budget-add fun 300.5 CNY
2023-12-20 budget-transfer fun food 100 CNY
2023-12-31 budget-close vacation

2023-12-02 * "KFC" "VME50 Package"
  Assets:BankCard -50 CNY
  Expenses:Food

2023-12-21 * "Cinema" "Tickets"
  Assets:BankCard -80 CNY
  Expenses:Fun
