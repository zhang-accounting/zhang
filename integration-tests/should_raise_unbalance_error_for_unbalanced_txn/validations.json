[
  {
    "method": "POST",
    "uri": "/api/query/builtins/journals.errors",
    "body": {
      "params": {
        "size": 100,
        "offset": 0
      },
      "count_total": true
    },
    "validations": [
      [
        "$.data[0].kind",
        "UnbalancedTransaction"
      ]
    ]
  },
  {
    "uri": "/api/journals",
    "validations": [
      [
        "$.data.records.length()",
        1
      ],
      [
        "$.data.records[0].postings.length()",
        2
      ],
      [
        "$.data.records[0].postings[0].unit.number",
        "-10"
      ],
      [
        "$.data.records[0].postings[1].unit.number",
        "100"
      ],
      [
        "$.data.records[0].is_balanced",
        false
      ]
    ]
  }
]
