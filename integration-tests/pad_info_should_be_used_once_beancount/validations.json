[
  {
    "uri": "/api/store",
    "validations": [
      [
        "$.data.errors.length()",
        1
      ],
      [
        "$.data.errors[0].error_type",
        "AccountBalanceCheckError"
      ],
      [
        "$.data.balance_assertions.length()",
        1
      ],
      [
        "$.data.balance_assertions[?(@.sequence==1)].passed",
        false
      ],
      [
        "$.data.balance_assertions[?(@.sequence==1)].balance.number",
        "0"
      ],
      [
        "$.data.transactions[*][?(@.sequence==2)].flag",
        "BalancePad"
      ]
    ]
  }
]
