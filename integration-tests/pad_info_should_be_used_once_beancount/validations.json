      ],
      [
        "$.data.balance_assertions.length()",
        1
      ],
      [
        "$.data.balance_assertions[?(@.sequence==2)].passed",
        true
      ],
      [
        "$.data.balance_assertions[?(@.sequence==2)].balance.number",
        "0.10"
      ]
    ]
  }
]
