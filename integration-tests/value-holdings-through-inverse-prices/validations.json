[
  {
    "uri": "/api/accounts",
    "validations": [
      [
        "$.data[?(@.name=='Assets:Bank')].amount.detail.USD",
        "100"
      ],
      [
        "$.data[?(@.name=='Assets:Bank')].amount.calculated.number",
        "800"
      ],
      [
        "$.data[?(@.name=='Assets:Bank')].amount.calculated.commodity",
        "CNY"
      ]
    ]
  },
  {
    "method": "POST",
    "uri": "/api/query/builtins/report.net_worth",
    "body": {
      "params": {
        "to": "2024-12-31",
        "currency": "CNY"
      }
    },
    "validations": [
      [
        "$.data[0].units.positions[?(@.units.currency=='USD')].units.number",
        "100"
      ],
      [
        "$.data[0].value.positions[?(@.units.currency=='CNY')].units.number",
        "800"
      ],
      [
        "$.data[0].value.positions[?(@.units.currency=='CNY')].units.currency",
        "CNY"
      ]
    ]
  },
  {
    "uri": "/api/commodities",
    "validations": [
      [
        "$.data[?(@.name=='USD')].total_amount",
        "100"
      ],
      [
        "$.data[?(@.name=='USD')].latest_price_date",
        "2024-01-01T00:00:00"
      ],
      [
        "$.data[?(@.name=='USD')].latest_price_amount",
        "8"
      ],
      [
        "$.data[?(@.name=='USD')].latest_price_commodity",
        "CNY"
      ]
    ]
  },
  {
    "uri": "/api/commodities/USD",
    "validations": [
      [
        "$.data.info.total_amount",
        "100"
      ],
      [
        "$.data.info.latest_price_date",
        "2024-01-01T00:00:00"
      ],
      [
        "$.data.info.latest_price_amount",
        "8"
      ],
      [
        "$.data.info.latest_price_commodity",
        "CNY"
      ]
    ]
  }
]
